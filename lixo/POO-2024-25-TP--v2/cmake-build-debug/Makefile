	$(MAKE) $(MAKESILENT) -f CMakeFiles\POO_2024_25_TP.dir\build.make CMakeFiles/POO_2024_25_TP.dir/main.cpp.i
.PHONY : main.cpp.i

main.s: main.cpp.s
.PHONY : main.s

# target to generate assembly for a file
main.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\POO_2024_25_TP.dir\build.make CMakeFiles/POO_2024_25_TP.dir/main.cpp.s
.PHONY : main.cpp.s

