+) {
+        moverEmDirecao({*/
+/* coordenadas da caravana do utilizador *//*
+});
+    } else {
+        // Movimento aleatório para uma posição adjacente
+        int direcaoAleatoria = rand() % 4;
+        if (direcaoAleatoria == 0) {
+            setPosicao(linha - 1, coluna);  // Mover para cima
+        } else if (direcaoAleatoria == 1) {
+            setPosicao(linha + 1, coluna);  // Mover para baixo
+        } else if (direcaoAleatoria == 2) {
+            setPosicao(linha, coluna - 1);  // Mover para a esquerda
+        } else {
+            setPosicao(linha, coluna + 1);  // Mover para a direita
+        }
