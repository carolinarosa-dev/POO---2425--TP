+++ b/CaravanaBarbara.h	(date 1732556194701)
@@ -0,0 +1,47 @@
+//
+// Created by Carolina Rosa on 25/11/2024.
+//
+/*
+
+#ifndef POO_2024_25_TP_CARAVANABARBARA_H
+#define POO_2024_25_TP_CARAVANABARBARA_H
+
+
+
+#include "Caravana.h"
+#include <cstdlib> // Para rand()
+#include <iostream>
+#include <utility>
+
+
+class CaravanaBarbara : Caravana {
+public:
+    CaravanaBarbara(int linha, int coluna);
+
+    // Sobrescreve o método de movimentação
+    void mover(char direcao);
+
+    // Método específico para verificar se há tempestade de areia
+    void verificarTempestade();
+
+    // Método específico para verificar aborrecimento dos bárbaros
+    void verificarAborrecimento();
+
+    // Método para a caravana seguir para a direção da caravana do utilizador
+    void moverEmDirecao(const pair<int, int> &direcao);
+
+    // Método para perder tripulantes em tempestades
+    void perderTripulantesPorTempestade();
+
+    // Função para aumentar o aborrecimento (pode ser chamada em cada turno)
+    void aumentarAborrecimento();
+
+private:
+    int turnoAborrecimento;  // Contador de turnos até o aborrecimento
+    bool destruida;          // Indicador se a caravana foi destruída
+};
+
+#endif //POO_2024_25_TP_CARAVANA_BARBARA_H
+
+
+*/
