+
+void CaravanaBarbara::moverEmDirecao(const pair<int, int> &direcao) {
+    // Lógica para mover em direção à caravana do utilizador
+    if (linha < direcao.first) {
+        setPosicao(linha + 1, coluna);  // Mover para baixo
+    } else if (linha > direcao.first) {
+        setPosicao(linha - 1, coluna);  // Mover para cima
+    }
+    if (coluna < direcao.second) {
